      "args": ["-y", "@modelcontextprotocol/server-filesystem", "./data"]
    },
    "crm-db": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@fabrikam/crm-mcp@1.4.2"],
      "env": {
        "CRM_API_KEY": "REPLACE_ME_demo_placeholder"
      }
    }
  }
}
