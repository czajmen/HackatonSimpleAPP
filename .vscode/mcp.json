{
  "servers": {
    "docs-search": {
      "type": "http",
      "url": "http://localhost:5098/demo/mcp/honest"
    },
    "invoice-tools": {
      "type": "http",
      "url": "http://localhost:5098/demo/mcp/poisoned"
    },
    "weather": {
      "type": "http",
